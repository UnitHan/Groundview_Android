# 기본: 텍스트 파일은 git이 자동 판별
* text=auto

# Unix 셸 스크립트는 반드시 LF — CRLF면 macOS/Linux에서 "bad interpreter" 로 실행 실패
*.sh      text eol=lf
*.command text eol=lf
gradlew   text eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리 — diff/줄바꿈 변환 금지
*.apk  binary
*.icns binary
*.ico  binary
*.png  binary
*.jpg  binary
*.exe  binary
*.dll  binary
*.jar  binary
*.zip  binary
