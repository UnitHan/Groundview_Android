AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.`
    }
  ];
  React.useEffect(() => {
    const off = window.groundview?.ui?.onInfo?.(() => setInfoOpen(true));
    return () => {
      if (off) off();
    };
  }, []);
  const bg =
    state.uiPhase === 'devices'
      ? '#f5f7fb'
      : state.uiPhase === 'welcome'
      ? '#f7f9fb'
      : 'radial-gradient(circle at 20% 20%, #1f2937, #0b1221)';
  const textColor = state.uiPhase === 'devices' || state.uiPhase === 'welcome' ? '#0f172a' : '#e5e7eb';

  const wrap = (content: React.ReactNode) => (
    <div
      style={{
        minHeight: '100vh',
        background: bg,
        color: textColor,
        padding: 16,
        fontFamily: 'Inter, system-ui, sans-serif',
        position: 'relative'
      }}
    >
      <style>{selectionStyle}</style>
      {content}
      {infoOpen && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            background: 'rgba(0,0,0,0.45)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            zIndex: 1100
          }}
          onClick={() => setInfoOpen(false)}
        >
          <div
            style={{
              background: '#0b1221',
              border: '1px solid #1f2937',
              borderRadius: 12,
              padding: 16,
              width: 520,
              maxWidth: '90%',
              color: '#e5e7eb',
              boxShadow: '0 16px 60px rgba(0,0,0,0.45)'
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 12 }}>
              <div>
                <div style={{ fontWeight: 800, fontSize: 16 }}>GroundView 정보</div>
                <div style={{ color: '#9ca3af', fontSize: 12 }}>버전 {appVersion} · 만든 사람: QA Bulls</div>
              </div>
              <button
                onClick={() => setInfoOpen(false)}
                style={{
                  border: 'none',
                  background: '#111827',
                  color: '#e5e7eb',
                  borderRadius: 6,
                  padding: '6px 10px',
                  cursor: 'pointer',
                  ...pressableStyle
                }}
                {...pressableHandlers}
              >
                Close
              </button>
            </div>
            <div style={{ marginBottom: 12, fontWeight: 700 }}>오픈소스 라이선스</div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
              {ossLicenses.map((lic) => (
                <div
                  key={lic.name}
                  style={{
                    background: '#0e1726',
                    border: '1px solid #1f2937',
                    borderRadius: 8,
                    padding: 10,
                    display: 'flex',
                    justifyContent: 'space-between',
                    alignItems: 'center'
                  }}
                >
                  <div>
                    <div style={{ fontWeight: 700 }}>{lic.name}</div>
                    <div style={{ color: '#9ca3af', fontSize: 12 }}>
                      v{lic.version} · {lic.license}
                    </div>
                  </div>
                  <button
                    onClick={() => setLicenseView({ name: lic.name, text: lic.text })}
                    style={{
                      border: '1px solid #1f2937',
                      background: '#2563eb',
                      color: '#fff',
                      borderRadius: 6,
                      padding: '6px 10px',
                      cursor: 'pointer',
                      ...pressableStyle
                    }}
                    {...pressableHandlers}
                  >
                    전문 보기
                  </button>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
      {licenseView && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            background: 'rgba(0,0,0,0.5)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            zIndex: 1150
          }}
          onClick={() => setLicenseView(null)}
        >
          <div
            style={{
              background: '#0b1221',
              border: '1px solid #1f2937',
              borderRadius: 12,
              padding: 16,
              width: 640,
              maxWidth: '90%',
              maxHeight: '80vh',
              overflowY: 'auto',
              color: '#e5e7eb',
              boxShadow: '0 16px 60px rgba(0,0,0,0.5)'
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
              <div>
                <div style={{ fontWeight: 800, fontSize: 16 }}>{licenseView.name}</div>
                <div style={{ color: '#9ca3af', fontSize: 12 }}>Open Source License</div>
              </div>
              <button
                onClick={() => setLicenseView(null)}
                style={{
                  border: 'none',
                  background: '#111827',
                  color: '#e5e7eb',
                  borderRadius: 6,
                  padding: '6px 10px',
                  cursor: 'pointer',
                  ...pressableStyle
                }}
                {...pressableHandlers}
              >
                Close
              </button>
            </div>
            <pre
              style={{
                whiteSpace: 'pre-wrap',
                wordBreak: 'break-word',
                background: '#0e1726',
                padding: 12,
                borderRadius: 8,
                border: '1px solid #1f2937',
                color: '#e5e7eb',
                fontSize: 12
              }}
            >
              {licenseView.text}
            </pre>
          </div>
        </div>
      )}
      {settingsOpen && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            background: 'rgba(0,0,0,0.5)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            zIndex: 1150
          }}
          onClick={() => {
            setSettingsOpen(false);
            setSaveStatus(null);
          }}
        >
          <div
            style={{
              background: '#0b1221',
              border: '1px solid #1f2937',
              borderRadius: 12,
              padding: 16,
              width: 520,
              maxWidth: '90%',
              color: '#e5e7eb',
              boxShadow: '0 16px 60px rgba(0,0,0,0.5)'
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
              <div>
                <div style={{ fontWeight: 800, fontSize: 16 }}>Gemini API 설정</div>
                <div style={{ color: '#9ca3af', fontSize: 12 }}>API Key는 암호화되어 안전하게 저장됩니다</div>
              </div>
              <button
                onClick={() => {
                  setSettingsOpen(false);
                  setSaveStatus(null);
                }}
                style={{
                  border: 'none',
                  background: '#111827',
                  color: '#e5e7eb',
                  borderRadius: 6,
                  padding: '6px 10px',
                  cursor: 'pointer',
                  ...pressableStyle
                }}
                {...pressableHandlers}
              >
                Close
              </button>
            </div>

            <div style={{ marginBottom: 12 }}>
              <label style={{ display: 'block', fontWeight: 700, marginBottom: 6 }}>API Key</label>
              <input
                type="password"
                value={geminiKey}
                onChange={(e) => setGeminiKey(e.target.value)}
                placeholder="AIza..."
                style={{
                  width: '100%',
                  padding: 10,
                  borderRadius: 8,
                  border: '1px solid #1f2937',
                  background: '#0e1726',
                  color: '#e5e7eb',
                  fontSize: 14
                }}
              />
            </div>

            <div style={{ marginBottom: 12 }}>
              <label style={{ display: 'block', fontWeight: 700, marginBottom: 6 }}>모델</label>
              <select
                value={geminiModel}
                onChange={(e) => setGeminiModel(e.target.value)}
                style={{
                  width: '100%',
                  padding: 10,
                  borderRadius: 8,
                  border: '1px solid #1f2937',
                  background: '#0e1726',
                  color: '#e5e7eb',
                  fontSize: 14
                }}
              >
                <option value="gemini-2.5-flash">gemini-2.5-flash</option>
                <option value="gemini-2.0-flash">gemini-2.0-flash</option>
                <option value="gemini-1.5-pro">gemini-1.5-pro</option>
                <option value="gemini-1.5-flash">gemini-1.5-flash</option>
              </select>
            </div>

            {saveStatus && (
              <div
                style={{
                  padding: 10,
                  borderRadius: 8,
                  marginBottom: 12,
                  background: saveStatus.type === 'success' ? 'rgba(34,197,94,0.15)' : 'rgba(239,68,68,0.15)',
                  color: saveStatus.type === 'success' ? '#4ade80' : '#f87171',
                  border: `1px solid ${saveStatus.type === 'success' ? '#22c55e' : '#ef4444'}`
                }}
              >
                {saveStatus.message}
              </div>
            )}

            <button
              onClick={handleSaveGeminiKey}
              style={{
                width: '100%',
                padding: 12,
                borderRadius: 8,
                border: 'none',
                background: '#2563eb',
                color: '#fff',
                fontWeight: 700,
                cursor: 'pointer',
                ...pressableStyle
              }}
              {...pressableHandlers}
            >
              💾 저장
            </button>

            <div style={{ marginTop: 12, fontSize: 12, color: '#9ca3af' }}>
              <div style={{ marginBottom: 4 }}>🔒 API Key는 PBKDF2-HMAC-SHA256 해시 + Fernet 암호화로 보호됩니다</div>
              <div>📌 Gemini API Key는 <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" style={{ color: '#60a5fa' }}>Google AI Studio</a>에서 발급받을 수 있습니다</div>
            </div>
          </div>
        </div>
      )}
    </div>
  );

  if (state.uiPhase === 'welcome') {
    return wrap(<Welcome />);
  }
  if (state.uiPhase === 'analyze' && state.lastCapture?.screenshotPath && state.tree) {
    return wrap(<AnalyzePage />);
  }
  return wrap(<DevicesPage />);
};

export default App;
